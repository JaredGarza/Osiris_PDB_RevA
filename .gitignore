*.lck
~*.*
*.bak
*-backups/
_autosave-*
.history/
fp-info-cache

# Local task backups
library_reorg_backup_*/
component-review-backup-*/
_restore_backup_*/

# LTspice source includes .asc, .cir and .lib. Exclude output at every depth.
