.PARAM Rs=538u      Rg=0.7       Rd=20u       Rm=370n

.PARAM Inn=10       Unn=10       Rmax=7.2m    gmin=17
.PARAM RRf=499m     Rrbond=0.038 Rtb=9.4      g2=971m
.PARAM act=1.4      Rsp=0.1     

.FUNC Pb(I,dT,Rb)  {Rb/(2*Rtb)*(I-limit(dT/(max(I,1n)*Rb)+RRf*I*g2,0,I))**2}

X1  d1 g s sp Tj S8_60_q_var PARAMS: a={act} Rsp={Rsp} dVth={dVth} dR={dRdson} dgfs={dgfs} Inn={Inn} Unn={Unn}
