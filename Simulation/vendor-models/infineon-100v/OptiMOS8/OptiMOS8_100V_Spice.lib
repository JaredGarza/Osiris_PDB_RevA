.SUBCKT IPB013N10NM8 drain gate source Tj Tcase PARAMS: dVth=0 dRdson=0 dC=0 Zthtype=0 Ls=3.6n Ld=0.1n Lg=6.5n

.PARAM Rs=564u      Rg=1.1       Rd=10u       Rm=120u

.PARAM Inn=100      Unn=10       Rmax=1.385m 
.PARAM RRf=276m     Rrbond=0.008 Rtb=4.3      g2=687m
.PARAM act=27.93    Rsp=0.1     

